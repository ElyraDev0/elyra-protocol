# Copy to ".env" (never share it, never commit it).
# A NEW wallet used only to deploy on Sepolia — never your main wallet.
PRIVATE_KEY=0x...
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# filled in AFTER the deploy (for the demo agent bot)
JOB_ESCROW=
DEMO_AGENT_ID=1

# ---- testnet monitor (see README.md → "Monitor and guardian") ----
ALERT_BOT_TOKEN=          # bot from @BotFather (can be a new bot just for alerts)
ALERT_CHAT_ID=            # your private chat id with the bot (from @RawDataBot or @userinfobot)
AGENT_BOND=
CREDIT_METER=
ELYRA_GUARD=
TEST_ELY=
TEST_USDC=
DEPLOY_BLOCK=             # block number of the deploy (shown on Etherscan for the first contract)
FAIL_ALERT_PER_HOUR=10

# ---- Guardian (automatic pause) ----
# A NEW, separate wallet just for the guardian: keep only a little ETH in it for gas (it can only press "pause").
# After deploy, from the project wallet: guard.setGuardian(<this wallet address>)  — or put GUARDIAN=<address> before deploying.
GUARDIAN=
GUARDIAN_PRIVATE_KEY=
# watch = only tells you "here I would have paused" (first 2–4 weeks) · act = really pauses
GUARDIAN_MODE=watch
CHECK_EVERY_SECONDS=20
# alerts only (never pause):
ALERT_OUTFLOW_PCT=20
ALERT_OUTFLOW_MINUTES=10
ALERT_OUTFLOW_MIN_USDC=200
ALERT_DISPUTES_PER_HOUR=10
ALERT_JOBS_PER_HOUR=200
